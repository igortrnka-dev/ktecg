# Public site URL (used for canonical links and the cron job)
NEXT_PUBLIC_SITE_URL=https://ktechnology.onrender.com

# Supabase (Project settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated e-mails allowed into /admin (users are created in Supabase Auth)
ADMIN_EMAILS=office@ktechnology.sk

# Anthropic API key for the sales automation
ANTHROPIC_API_KEY=

# Max website inquiries per UTC day that Claude qualifies (the rest are saved without AI)
INQUIRY_AI_DAILY_CAP=50

# Shared secret for the scheduled prospecting job
CRON_SECRET=

# Company mailbox, read-only over IMAP for "Pošta" (Websupport: imap.websupport.sk, port 993, TLS).
# The admin only reads INBOX and the sent folder; it never sends, moves or marks mail.
IMAP_HOST=imap.websupport.sk
IMAP_PORT=993
IMAP_USER=office@ktechnology.sk
IMAP_PASSWORD=
# Optional: the sent folder's exact name, if it is not found on its own (\Sent, Sent, INBOX.Sent, Sent Items, Odoslané)
IMAP_SENT_FOLDER=
